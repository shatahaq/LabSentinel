{
  "$comment": "Protocol version 1. Generated by export_schema.py.",
  "$defs": {
    "AckPayload": {
      "additionalProperties": false,
      "description": "Agent confirms it applied a command (by the command's envelope id).",
      "properties": {
        "ack_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Ack Id",
          "type": "string"
        },
        "agent_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "message": {
          "default": "",
          "maxLength": 256,
          "title": "Message",
          "type": "string"
        },
        "ok": {
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "resulting_state": {
          "$ref": "#/$defs/AgentState"
        },
        "type": {
          "const": "ack",
          "default": "ack",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "ack_id",
        "resulting_state"
      ],
      "title": "AckPayload",
      "type": "object"
    },
    "AgentState": {
      "description": "The agent's own view of what it is doing right now.\n\nReported in heartbeats and command ACKs so the dashboard shows *real*\nagent state, never just the last button pressed.",
      "enum": [
        "enforcing",
        "paused",
        "dry_run"
      ],
      "title": "AgentState",
      "type": "string"
    },
    "AppRule": {
      "description": "A single allowed application.\n\nAn app may be allowed by name alone, or pinned to a verified identity\n(expected path and/or SHA-256) so a renamed game cannot impersonate it.",
      "properties": {
        "display_name": {
          "default": "",
          "maxLength": 120,
          "title": "Display Name",
          "type": "string"
        },
        "expected_path_contains": {
          "anyOf": [
            {
              "maxLength": 260,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Path Contains"
        },
        "expected_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sha256"
        },
        "process_name": {
          "maxLength": 260,
          "minLength": 1,
          "title": "Process Name",
          "type": "string"
        }
      },
      "required": [
        "process_name"
      ],
      "title": "AppRule",
      "type": "object"
    },
    "CommandPayload": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "$ref": "#/$defs/CommandType"
        },
        "issued_by": {
          "default": "",
          "maxLength": 128,
          "title": "Issued By",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnforcementMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "default": "",
          "maxLength": 1024,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "command",
          "default": "command",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "title": "CommandPayload",
      "type": "object"
    },
    "CommandType": {
      "description": "Admin -> agent remote commands.",
      "enum": [
        "pause",
        "resume",
        "set_dry_run",
        "lock_screen",
        "broadcast_message",
        "set_stream"
      ],
      "title": "CommandType",
      "type": "string"
    },
    "EnforcementMode": {
      "description": "Operating profile selected by the admin, pushed to agents.",
      "enum": [
        "exam",
        "lab",
        "free"
      ],
      "title": "EnforcementMode",
      "type": "string"
    },
    "GoodbyePayload": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "reason": {
          "default": "shutdown",
          "maxLength": 128,
          "title": "Reason",
          "type": "string"
        },
        "type": {
          "const": "goodbye",
          "default": "goodbye",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "agent_id"
      ],
      "title": "GoodbyePayload",
      "type": "object"
    },
    "HeartbeatPayload": {
      "additionalProperties": false,
      "properties": {
        "active_window_title": {
          "default": "",
          "maxLength": 256,
          "title": "Active Window Title",
          "type": "string"
        },
        "agent_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "cpu_percent": {
          "default": 0.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Cpu Percent",
          "type": "number"
        },
        "desktop_access": {
          "default": true,
          "title": "Desktop Access",
          "type": "boolean"
        },
        "indicator_visible": {
          "default": true,
          "title": "Indicator Visible",
          "type": "boolean"
        },
        "mem_mb": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Mem Mb",
          "type": "number"
        },
        "rule_revision": {
          "minimum": -1,
          "title": "Rule Revision",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/AgentState"
        },
        "type": {
          "const": "heartbeat",
          "default": "heartbeat",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "state",
        "rule_revision"
      ],
      "title": "HeartbeatPayload",
      "type": "object"
    },
    "HelloPayload": {
      "additionalProperties": false,
      "description": "First message from an agent: identify + request to join a session.",
      "properties": {
        "agent_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "agent_version": {
          "default": "0.0.0",
          "maxLength": 32,
          "title": "Agent Version",
          "type": "string"
        },
        "cached_rule_revision": {
          "default": -1,
          "minimum": -1,
          "title": "Cached Rule Revision",
          "type": "integer"
        },
        "hostname": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Hostname",
          "type": "string"
        },
        "os_version": {
          "default": "",
          "maxLength": 64,
          "title": "Os Version",
          "type": "string"
        },
        "pairing_code": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pairing Code"
        },
        "type": {
          "const": "hello",
          "default": "hello",
          "title": "Type",
          "type": "string"
        },
        "username": {
          "default": "",
          "maxLength": 128,
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "hostname"
      ],
      "title": "HelloPayload",
      "type": "object"
    },
    "RejectPayload": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "maxLength": 256,
          "title": "Reason",
          "type": "string"
        },
        "server_protocol_version": {
          "default": 1,
          "title": "Server Protocol Version",
          "type": "integer"
        },
        "type": {
          "const": "reject",
          "default": "reject",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "RejectPayload",
      "type": "object"
    },
    "RuleSet": {
      "description": "The complete, versioned ruleset handed to an agent.",
      "properties": {
        "app_whitelist": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AppRule"
          },
          "title": "App Whitelist",
          "type": "array"
        },
        "block_incognito": {
          "default": true,
          "title": "Block Incognito",
          "type": "boolean"
        },
        "close_grace_seconds": {
          "default": 5,
          "maximum": 60,
          "minimum": 0,
          "title": "Close Grace Seconds",
          "type": "integer"
        },
        "dry_run": {
          "default": true,
          "description": "Audit-only; default-on for first install.",
          "title": "Dry Run",
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/EnforcementMode",
          "default": "lab"
        },
        "revision": {
          "description": "Monotonic; agent ignores stale revisions.",
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "site_blocklist": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SiteRule"
          },
          "title": "Site Blocklist",
          "type": "array"
        }
      },
      "required": [
        "revision"
      ],
      "title": "RuleSet",
      "type": "object"
    },
    "RulesUpdatePayload": {
      "additionalProperties": false,
      "properties": {
        "ruleset": {
          "$ref": "#/$defs/RuleSet"
        },
        "type": {
          "const": "rules_update",
          "default": "rules_update",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "ruleset"
      ],
      "title": "RulesUpdatePayload",
      "type": "object"
    },
    "ScreenFramePayload": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "captured_at": {
          "title": "Captured At",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 4320,
          "title": "Height",
          "type": "integer"
        },
        "hi_res": {
          "default": false,
          "title": "Hi Res",
          "type": "boolean"
        },
        "jpeg_b64": {
          "minLength": 1,
          "title": "Jpeg B64",
          "type": "string"
        },
        "type": {
          "const": "screen_frame",
          "default": "screen_frame",
          "title": "Type",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 7680,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "agent_id",
        "width",
        "height",
        "jpeg_b64",
        "captured_at"
      ],
      "title": "ScreenFramePayload",
      "type": "object"
    },
    "SiteRule": {
      "description": "A blocked-site entry.\n\n``pattern`` is a Chrome/Edge URLBlocklist pattern (e.g. ``example.com`` or\n``*://*.example.com/*``). ``keywords`` feed the supplementary, lower-precision\nwindow-title detector.",
      "properties": {
        "category": {
          "default": "lainnya",
          "maxLength": 60,
          "title": "Category",
          "type": "string"
        },
        "keywords": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "pattern": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "SiteRule",
      "type": "object"
    },
    "ViolationKind": {
      "description": "What triggered a violation record.",
      "enum": [
        "app_blocked",
        "app_closed",
        "impersonation",
        "site_title",
        "agent_tamper"
      ],
      "title": "ViolationKind",
      "type": "string"
    },
    "ViolationPayload": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 1024,
          "title": "Detail",
          "type": "string"
        },
        "detected_from_title": {
          "default": false,
          "title": "Detected From Title",
          "type": "boolean"
        },
        "dry_run": {
          "default": false,
          "description": "True = would-have-acted only.",
          "title": "Dry Run",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ViolationKind"
        },
        "occurred_at": {
          "title": "Occurred At",
          "type": "number"
        },
        "screenshot_b64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screenshot B64"
        },
        "subject": {
          "description": "app/process name or site/title text",
          "maxLength": 512,
          "title": "Subject",
          "type": "string"
        },
        "type": {
          "const": "violation",
          "default": "violation",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "kind",
        "subject",
        "occurred_at"
      ],
      "title": "ViolationPayload",
      "type": "object"
    },
    "WelcomePayload": {
      "additionalProperties": false,
      "properties": {
        "agent_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Token"
        },
        "heartbeat_interval_s": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Heartbeat Interval S",
          "type": "number"
        },
        "ruleset": {
          "$ref": "#/$defs/RuleSet"
        },
        "server_time": {
          "title": "Server Time",
          "type": "number"
        },
        "session_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "type": {
          "const": "welcome",
          "default": "welcome",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "server_time",
        "ruleset"
      ],
      "title": "WelcomePayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The only object that ever touches the socket.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "ack": "#/$defs/AckPayload",
          "command": "#/$defs/CommandPayload",
          "goodbye": "#/$defs/GoodbyePayload",
          "heartbeat": "#/$defs/HeartbeatPayload",
          "hello": "#/$defs/HelloPayload",
          "reject": "#/$defs/RejectPayload",
          "rules_update": "#/$defs/RulesUpdatePayload",
          "screen_frame": "#/$defs/ScreenFramePayload",
          "violation": "#/$defs/ViolationPayload",
          "welcome": "#/$defs/WelcomePayload"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/HelloPayload"
        },
        {
          "$ref": "#/$defs/HeartbeatPayload"
        },
        {
          "$ref": "#/$defs/ViolationPayload"
        },
        {
          "$ref": "#/$defs/ScreenFramePayload"
        },
        {
          "$ref": "#/$defs/AckPayload"
        },
        {
          "$ref": "#/$defs/GoodbyePayload"
        },
        {
          "$ref": "#/$defs/WelcomePayload"
        },
        {
          "$ref": "#/$defs/RejectPayload"
        },
        {
          "$ref": "#/$defs/RulesUpdatePayload"
        },
        {
          "$ref": "#/$defs/CommandPayload"
        }
      ],
      "title": "Payload"
    },
    "token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Token"
    },
    "ts": {
      "title": "Ts",
      "type": "number"
    },
    "v": {
      "default": 1,
      "description": "Protocol version.",
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "payload"
  ],
  "title": "LabSentinel Protocol Envelope",
  "type": "object"
}
